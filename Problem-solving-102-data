// Challenge 1: Find duplicates in a list
// Approach:
// I will compare each item in the array with the names I have already seen.
// If an item appears again and is not already in the duplicate list,
// I will add it to the duplicate list.

const names = [
    "Alice",
    "Bob",
    "David",
    "Alice",
    "Sarah",
    "Bob",
];

function findDuplicates(array) {
    let seen = [];
    let duplicates = [];
    for (let name of array) {

        if (seen.includes(name)) {

            if (!duplicates.includes(name)) {
                duplicates.push(name);
            }

        } else {

            seen.push(name);
        }
    }
    return duplicates;
}
console.log("Duplicates:");
console.log(findDuplicates(names));



// Challenge 2: Find fellows who scored above a certain mark
// Approach:
// I will go through each fellow's information and compare their score
// with the required mark. If the score is higher than the limit,
// I will add that fellow to a new list of successful results.

const fellows = [
    {
        name: "Don",
        score: 85
    },
    {
        name: "Chris",
        score: 65
    },
    {
        name: "Anna",
        score: 90
    },
    {
        name: "Mark",
        score: 70
    }
];

function findHighScores(fellows, limit) {

    let successfulFellows = [];

    for (let fellow of fellows) {

        if (fellow.score > limit) {
            successfulFellows.push(fellow);
        }
    }
    return successfulFellows;
}

let result = findHighScores(fellows, 70);
console.log("Fellows who scored above 70:");

for (let fellow of result) {
    console.log(`${fellow.name} scored ${fellow.score}`);
}



// Challenge 3: Group items by category
// Approach:
// I will go through each product and check its category.
// If the category already exists, I will add the product to it.
// If the category does not exist, I will create a new category first.

const products = [
    {
        name: "Laptop",
        category: "Technology"
    },
    {
        name: "Phone",
        category: "Technology"
    },
    {
        name: "Chair",
        category: "Furniture"
    },
    {
        name: "Table",
        category: "Furniture"
    },
    {
        name: "Book",
        category: "Education"
    }
];

function groupByCategory(products) {

    let groupedProducts = {};

    for (let product of products) {
        let category = product.category;

        if (!groupedProducts[category]) {
            groupedProducts[category] = [];
        }
        groupedProducts[category].push(product.name);
    }
    return groupedProducts;
}

console.log("Products grouped by category:");
let groupedResult = groupByCategory(products);
for (let category in groupedResult) {
    console.log(category + ":");

    for (let item of groupedResult[category]) {
        console.log("- " + item);
    }
}
